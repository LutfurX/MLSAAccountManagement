rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // School application users collection (Headmaster admin & Committee viewers)
    match /app_users/{userId} {
      allow read, write: if true;
    }

    // Student fees collection
    match /student_fees/{feeId} {
      allow read, write: if true;
    }

    // School daily expenses collection
    match /school_expenses/{expenseId} {
      allow read, write: if true;
    }

    // School bank transactions collection
    match /bank_transactions/{txId} {
      allow read, write: if true;
    }

    // System configurations
    match /system_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
